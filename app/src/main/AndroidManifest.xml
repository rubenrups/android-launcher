<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for ACTION_DELETE (uninstall) on API 28+ -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Lets the swipe-down gesture open the notification shade -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Weather in the header and the update check (both optional, off by default) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Next calendar event in the header (asked for at runtime when you switch it on) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Self-update: download the new build, install it through the system installer, skip big downloads on mobile data -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A launcher must see every installed app (Android 11+ package visibility) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Package visibility: all launchable apps, plus installed icon packs (ADW / Nova / Apex / GO) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Rups Launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <!-- Registers us as a selectable home app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also lets us be started from another launcher / adb -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Add to home screen" requests (Chrome shortcuts, contacts, …) -->
        <activity
            android:name=".PinShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Launcher">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <receiver android:name=".data.InstallResultReceiver" android:exported="false" />

        <service
            android:name=".notifications.LauncherNotificationService"
            android:exported="true"
            android:label="Rups Launcher notifications"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
